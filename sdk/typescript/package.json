{
  "name": "@koyote/sdk",
  "version": "1.1.3",
  "description": "TypeScript SDK for Koyote - AST analysis, contract verification & kernel-isolated execution",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "LICENSE"
  ],
  "scripts": {
    "build": "napi build --platform --release --cargo-cwd ./native .",
    "build:target": "napi build --platform --release --cargo-cwd ./native .",
    "test": "node test/smoke.mjs",
    "prepack": "npm run build:target"
  },
  "napi": {
    "name": "koyote-native",
    "triples": {
      "defaults": true
    },
    "binaryName": "koyote-native"
  },
  "optionalDependencies": {
    "@koyote/sdk-darwin-arm64": "1.0.4",
    "@koyote/sdk-darwin-x64": "1.0.4"
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "keywords": [
    "koyote",
    "sandbox",
    "kernel",
    "isolation",
    "security",
    "landlock",
    "seatbelt",
    "compression",
    "ai",
    "agent",
    "compartment"
  ],
  "license": "Apache-2.0",
  "author": "Koyote Labs (Devaretanmay) <tanmaydevare@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Devaretanmay/Koyote.git"
  },
  "homepage": "https://github.com/Devaretanmay/Koyote#readme",
  "bugs": {
    "url": "https://github.com/Devaretanmay/Koyote/issues"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
